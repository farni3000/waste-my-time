# Copy to .env and fill in. Never commit .env.
STEAM_API_KEY=
# SteamID64 or vanity name. Can also be set later in the UI.
STEAM_ID=

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Leer = Modell wird pro Lauf aus der Tier-Klasse aufgelöst (empfohlen).
DEEPSEEK_MODEL=
# pro (default) oder flash
DEEPSEEK_MODEL_TIER=pro
# low, high, max oder leer = Provider-Default
LLM_REASONING_EFFORT=low
LLM_MAX_TOKENS=4000

APP_HOST=127.0.0.1
APP_PORT=8765
DB_PATH=data/app.db
TIMEZONE=Europe/Berlin
